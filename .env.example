# Copy this file to .env.local and fill in the values (Next.js only reads .env.local).
# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Gemini models to try in order, comma-separated (first = preferred). If one is busy or
# retired, the app moves on to the next. The older NEXT_PUBLIC_GEMINI_MODEL still works.
NEXT_PUBLIC_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
